{
  "name": "qiaomu-subcast-dsh",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build && node scripts/build-native.mjs",
    "i18n": "node scripts/i18n.mjs",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "hls.js": "^1.5.20",
    "lucide-react": "^0.460.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.1.0"
  },
  "description": "SubCast · 声渡 for DeepSeek Harness",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host",
    "client.js",
    "dist",
    "bin",
    "cordis.patch.yml",
    "LICENSE",
    "scripts",
    "tests",
    "src",
    "native/src",
    "native/.cargo",
    "native/Cargo.lock",
    "native/Cargo.toml",
    "index.html",
    "tsconfig*.json",
    "vite.config.ts",
    "docs/*.png"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "meta": {
      "title": "SubCast · 声渡",
      "description": "播客、YouTube、双语字幕与 AI 精读"
    }
  }
}
